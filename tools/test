#!/usr/bin/env python3
"""Run the tests against a throwaway PostgreSQL that this script starts and removes.

  tools/test                         every test, on the newest PostgreSQL installed, with .venv's Python
  tools/test --pg 18                 on PostgreSQL 18 (/usr/lib/postgresql/18/bin), or --pg-bin DIR
  tools/test --python PATH           with another interpreter (it needs the server extras: psycopg, flask)
  tools/test --agent-only            only the agent's tests (test_agent, test_extract, test_registry, test_releases): no
                                     PostgreSQL, standard library only
  tools/test test_server.TestSymlinks ...   only these
  tools/test --matrix [--jobs N]     each Python in .matrix/ and each PostgreSQL installed once, paired oldest with
                                     oldest (the shorter list repeats); --matrix full: every pair. One line per
                                     run; logs in .matrix/logs/. Make the environments with tools/test --setup
                                     (needs uv).
  tools/test --wheel [--pg N]        build the sdist and, from it, the wheel (python -m build); install the wheel with
                                     the server extras into a new environment (uv); run every test there against the
                                     installed copy, not this tree: what a release would ship.

The cluster lives in a new temporary folder, listens only on a Unix socket there (no port to collide with), runs
without fsync, and is stopped and deleted afterwards, failed or not. A run that skips a server or web test (no
database, Flask or psycopg missing) fails: "OK" means everything ran. The last line says what it ran on.
"""

import argparse
import glob
import os
import platform
import shutil
import subprocess
import sys
import tempfile
import time
import zipfile
from concurrent.futures import ThreadPoolExecutor

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Run inside the interpreter under test: the suite, then every skip, as "SKIP<tab>test<tab>reason" lines.
DRIVER = r"""
import sys, unittest
names = sys.argv[1:]
sys.path.insert(0, "tests")  # as `python -m unittest discover -s tests` has it: test_agent, test_server, ...
loader = unittest.defaultTestLoader
suite = loader.loadTestsFromNames(names) if names else loader.discover("tests")
result = unittest.TextTestRunner(verbosity=1).run(suite)
for test, why in result.skipped:
    print("SKIP\t%s\t%s" % (test.id(), why))
sys.exit(0 if result.wasSuccessful() else 1)
"""

# Skips that mean part of the suite didn't run here, rather than a test that doesn't apply (e.g. running as root).
MISSING = ("PINAKES_TEST_PGHOST", "not installed", "psycopg")


def pg_bin(args):
    if args.pg_bin:
        return args.pg_bin
    found = sorted(glob.glob("/usr/lib/postgresql/*/bin/initdb"), key=lambda p: int(p.split("/")[4]))
    if args.pg:
        want = "/usr/lib/postgresql/%s/bin" % args.pg
        if not os.path.exists(want + "/initdb"):
            sys.exit("tools/test: no PostgreSQL %s (%s/initdb); installed: %s"
                     % (args.pg, want, ", ".join(p.split("/")[4] for p in found) or "none"))
        return want
    if not found:
        sys.exit("tools/test: no PostgreSQL under /usr/lib/postgresql; give --pg-bin DIR")
    return os.path.dirname(found[-1])


def installed_pg():
    return sorted((p.split("/")[4] for p in glob.glob("/usr/lib/postgresql/*/bin/initdb")), key=int)


def matrix_pythons():
    found = glob.glob(os.path.join(HERE, ".matrix", "py3.*", "bin", "python"))
    return sorted(found, key=lambda p: [int(x) for x in p.split("/")[-3][2:].split(".")])


MATRIX_PYTHONS = ("3.10", "3.11", "3.12", "3.13", "3.14", "3.15")


def setup(pythons):
    """One environment per Python under .matrix/, made with uv (from .venv, else on PATH): the package editable,
    with the server extras (and tomli on 3.10)."""
    uv = os.path.join(HERE, ".venv/bin/uv") if os.path.exists(os.path.join(HERE, ".venv/bin/uv")) else "uv"
    for v in pythons:
        env = os.path.join(HERE, ".matrix", "py" + v)
        extra = "server,agent310" if v == "3.10" else "server"
        subprocess.run([uv, "venv", "-q", "--allow-existing", "--python", v, env], check=True)
        subprocess.run([uv, "pip", "install", "-q", "--python", os.path.join(env, "bin/python"),
                        "-e", "%s[%s]" % (HERE, extra)], check=True)
        print("tools/test: .matrix/py%s ready" % v)
    return 0


def matrix(args):
    pythons, pgs = matrix_pythons(), installed_pg()
    if not pythons:
        sys.exit("tools/test: no environments in .matrix/: make them with tools/test --setup")
    if not pgs:
        sys.exit("tools/test: no PostgreSQL under /usr/lib/postgresql")
    if args.matrix == "full":
        runs = [(py, pg) for py in pythons for pg in pgs]
    else:
        # every version once: the longer list in order, the shorter spread over it, oldest with oldest
        n = max(len(pythons), len(pgs))
        runs = [(pythons[i * len(pythons) // n], pgs[i * len(pgs) // n]) for i in range(n)]
    logs = os.path.join(HERE, ".matrix", "logs")
    os.makedirs(logs, exist_ok=True)

    def one(run_):
        py, pg = run_
        name = "%s-pg%s" % (py.split("/")[-3].lstrip(".") if ".matrix" in py else "venv", pg)
        start = time.monotonic()
        with open(os.path.join(logs, name + ".log"), "w") as log:
            rc = subprocess.run([sys.executable, os.path.abspath(__file__), "--python", py, "--pg", pg],
                                stdout=log, stderr=subprocess.STDOUT).returncode
        with open(os.path.join(logs, name + ".log")) as log:
            text = log.read()
        ran = [l for l in text.splitlines() if l.startswith("Ran ")]
        last = [l for l in text.splitlines() if l.startswith(("tools/test: OK on", "tools/test: FAILED on"))]
        line = "%-6s %-14s %4.0f s  %s" % ("OK" if rc == 0 else "FAILED", name, time.monotonic() - start,
                                           (ran[-1][4:] + "; " if ran else "") + (last[-1].split(" on ", 1)[1]
                                                                                  if last else "see its log"))
        print(line, flush=True)
        return rc == 0

    print("tools/test: %d run(s), %d at a time; logs in .matrix/logs/" % (len(runs), args.jobs), flush=True)
    with ThreadPoolExecutor(max_workers=args.jobs) as pool:
        results = list(pool.map(one, runs))
    print("tools/test: matrix %s: %d of %d runs OK" % ("OK" if all(results) else "FAILED", sum(results),
                                                       len(results)))
    return 0 if all(results) else 1


def wheel(args):
    """Build, install into a clean environment, and run the tests from a copy of tests/ (with the example config
    and QUERIES.md they read), so `import pinakes` finds the installed package, never this tree."""
    here_py = os.path.join(HERE, ".venv/bin/python")
    uv = os.path.join(HERE, ".venv/bin/uv")
    tmp = tempfile.mkdtemp(prefix="pinakes-wheel-")
    try:
        # build from a clean copy: the files git tracks or would (ignored ones left out), so nothing left in this
        # tree by an editable install (pinakes.egg-info, whose file list setuptools trusts) slips into the package
        tree = os.path.join(tmp, "tree")
        files = subprocess.run(["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"], cwd=HERE,
                               check=True, stdout=subprocess.PIPE, text=True).stdout.split("\0")
        for f in filter(None, files):
            if os.path.isfile(os.path.join(HERE, f)):
                os.makedirs(os.path.dirname(os.path.join(tree, f)), exist_ok=True)
                shutil.copy2(os.path.join(HERE, f), os.path.join(tree, f))
        dist = os.path.join(tmp, "dist")
        b = subprocess.run([here_py, "-m", "build", "--outdir", dist, tree], stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, text=True)
        if b.returncode:
            print(b.stdout)
            sys.exit("tools/test: the build failed (above)")
        built = sorted(os.listdir(dist))
        whl = [f for f in built if f.endswith(".whl")]
        print("tools/test: built %s" % ", ".join(built), flush=True)
        with zipfile.ZipFile(os.path.join(dist, whl[0])) as z:  # what a machine installs: the package, nothing more
            extra = [n for n in z.namelist() if not n.startswith(("pinakes/", "pinakes-"))]
            dev = [n for n in z.namelist() if n.startswith(("pinakes/tests/", "pinakes/tools/"))]
        if extra or dev:
            sys.exit("tools/test: the wheel holds more than the package: %s" % ", ".join(extra + dev))
        env = os.path.join(tmp, "venv")
        subprocess.run([uv, "venv", "-q", "--python", here_py, env], check=True)
        py = os.path.join(env, "bin", "python")
        subprocess.run([uv, "pip", "install", "-q", "--python", py, os.path.join(dist, whl[0]) + "[server]"],
                       check=True)
        src = os.path.join(tmp, "src")
        shutil.copytree(os.path.join(HERE, "tests"), os.path.join(src, "tests"),
                        ignore=shutil.ignore_patterns("__pycache__"))
        for f in ("QUERIES.md", "config.example.toml", "RELEASES.toml"):
            shutil.copy(os.path.join(HERE, f), src)
        where = subprocess.run([py, "-c", "import pinakes; print(pinakes.__file__)"], cwd=src, check=True,
                               stdout=subprocess.PIPE, text=True).stdout.strip()
        if not where.startswith(env):
            sys.exit("tools/test: the tests would import %s, not the installed wheel" % where)
        for script in ("pinakes-agent", "pinakes-ingest", "pinakes", "pinakes-web"):
            subprocess.run([os.path.join(env, "bin", script), "--help"], check=True, stdout=subprocess.DEVNULL)
        print("tools/test: installed in a new environment; pinakes from %s; the four commands start"
              % os.path.relpath(where, tmp), flush=True)
        cmd = [sys.executable, os.path.abspath(__file__), "--python", py, "--tests-from", src]
        if args.pg:
            cmd += ["--pg", args.pg]
        if args.agent_only:
            cmd += ["--agent-only"]
        return subprocess.run(cmd + args.tests).returncode
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def run(cmd, **kw):
    return subprocess.run(cmd, check=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, **kw)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], epilog=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--pg", help="PostgreSQL major version, from /usr/lib/postgresql/N/bin")
    ap.add_argument("--pg-bin", help="the folder holding initdb and pg_ctl")
    ap.add_argument("--python", help="the interpreter to test with (default: .venv/bin/python, else this one)")
    ap.add_argument("--agent-only", action="store_true",
                    help="test_agent, test_extract, test_registry and test_releases only; no PostgreSQL")
    ap.add_argument("--keep", action="store_true", help="on failure, keep the cluster's folder and say where")
    ap.add_argument("--matrix", nargs="?", const="lean", choices=("lean", "full"),
                    help="run across Pythons and PostgreSQL versions (see above)")
    ap.add_argument("--jobs", type=int, default=1, help="matrix runs at a time (each has its own cluster)")
    ap.add_argument("--setup", nargs="*", metavar="VERSION",
                    help="make .matrix/ environments with uv (default: %s)" % " ".join(MATRIX_PYTHONS))
    ap.add_argument("--wheel", action="store_true", help="test the built wheel, installed (see above)")
    ap.add_argument("--tests-from", default=HERE, help=argparse.SUPPRESS)  # --wheel: a copy of tests/
    ap.add_argument("tests", nargs="*", help="test names (default: all)")
    args = ap.parse_args()
    if args.wheel:
        return wheel(args)
    if args.setup is not None:
        return setup(args.setup or MATRIX_PYTHONS)
    if args.matrix:
        return matrix(args)

    python = args.python or (os.path.join(HERE, ".venv/bin/python")
                             if os.path.exists(os.path.join(HERE, ".venv/bin/python")) else sys.executable)
    pyver = subprocess.run([python, "-c", "import platform; print(platform.python_version())"],
                           check=True, stdout=subprocess.PIPE, text=True).stdout.strip()
    env = dict(os.environ)
    for k in ("PINAKES_TEST_PGHOST", "PINAKES_TEST_PGUSER", "PGHOST", "PGPORT", "PGUSER", "PGDATABASE"):
        env.pop(k, None)
    names = args.tests or (["test_agent", "test_extract", "test_registry", "test_releases"] if args.agent_only else [])
    on = "Python %s, %s %s, %s" % (pyver, platform.system(), platform.release(), platform.machine())

    tmp = None
    pg = None
    ok = False
    try:
        if not args.agent_only:
            bindir = pg_bin(args)
            # a socket path is limited to about 100 bytes: keep the folder short
            base = tempfile.gettempdir()
            tmp = tempfile.mkdtemp(prefix="pinakes-pg-", dir=base if len(base) < 60 else "/tmp")
            data = os.path.join(tmp, "data")
            run([os.path.join(bindir, "initdb"), "-D", data, "-U", "postgres", "-A", "trust", "--no-sync",
                 "-E", "UTF8", "--locale", "C.UTF-8"])
            run([os.path.join(bindir, "pg_ctl"), "-D", data, "-l", os.path.join(tmp, "log"), "-w", "-o",
                 "-k %s -c listen_addresses='' -p 5432 -c fsync=off -c synchronous_commit=off "
                 "-c full_page_writes=off -c max_connections=50" % tmp, "start"])
            pg = (bindir, data)
            version = run([os.path.join(bindir, "postgres"), "--version"]).stdout.strip()
            on = "%s, %s" % (version.replace("postgres (PostgreSQL) ", "PostgreSQL "), on)
            env.update(PINAKES_TEST_PGHOST=tmp, PINAKES_TEST_PGUSER="postgres", PGPORT="5432")
        print("tools/test: on %s" % on, flush=True)
        proc = subprocess.run([python, "-c", DRIVER] + names, cwd=args.tests_from, env=env, stdout=subprocess.PIPE,
                              text=True)
        skips = []
        for line in proc.stdout.splitlines():
            if line.startswith("SKIP\t"):
                skips.append(line.split("\t", 2)[1:])
            else:
                print(line)
        missing = [s for s in skips if any(m in s[1] for m in MISSING)] if not args.agent_only else []
        for test, why in skips:
            print("skipped: %s: %s" % (test, why))
        if missing:
            print("tools/test: FAILED: %d test(s) skipped for something missing here (above): not a full run"
                  % len(missing))
        ok = proc.returncode == 0 and not missing
        print("tools/test: %s on %s" % ("OK" if ok else "FAILED", on))
    except subprocess.CalledProcessError as e:
        print("tools/test: %s failed:\n%s" % (" ".join(e.cmd[:1]), e.stdout), file=sys.stderr)
    finally:
        if pg:
            subprocess.run([os.path.join(pg[0], "pg_ctl"), "-D", pg[1], "-m", "immediate", "stop"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if tmp:
            if args.keep and not ok:
                print("tools/test: kept %s (its server log: log)" % tmp)
            else:
                shutil.rmtree(tmp, ignore_errors=True)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
