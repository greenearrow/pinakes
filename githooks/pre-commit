#!/bin/sh
# Block the commit if staged changes contain private data, or if they touch code and the agent's tests fail.
# Installed by:
#   git config core.hooksPath githooks
# The agent's tests take a few seconds and need no database; they run on the working tree as it is, so unstaged
# changes count too. PINAKES_SKIP_TESTS=1 skips them for one commit (the leak scan still runs); the full suite is
# tools/test, run by hand.
top="$(git rev-parse --show-toplevel)"
"$top/tools/leak-scan" --staged || exit 1

[ -n "$PINAKES_SKIP_TESTS" ] && exit 0
git diff --cached --name-only --diff-filter=ACMRD | grep -qE '^(pinakes/|tests/|tools/test$|pyproject\.toml$)' || exit 0
if ! out="$("$top/tools/test" --agent-only 2>&1)"; then
    printf '%s\n' "$out" | tail -40
    echo "pre-commit: the agent's tests failed (above); fix them, or PINAKES_SKIP_TESTS=1 to commit anyway" >&2
    exit 1
fi
printf '%s\n' "$out" | tail -1
